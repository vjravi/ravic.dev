---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { bio, experience, skills } from '../data/about';
---
<BaseLayout
  title="About"
  description={`About ${site.name} — freelance AI engineer & technical architect in Munich. 10+ years in speech recognition, generative AI, and cloud architecture.`}
>
  <div class="fade-up">
    <section class="mx-auto max-w-[1000px] px-[clamp(22px,5vw,64px)] py-[clamp(44px,6vw,80px)]">
      <!-- Intro -->
      <div class="mb-[clamp(48px,7vw,88px)] flex flex-wrap items-start gap-[clamp(36px,5vw,72px)]">
        <div class="flex-[0_0_220px]">
          <div class="mb-[14px] flex items-center gap-[9px] font-mono text-[12px] uppercase tracking-[.14em] text-teal">
            <span class="h-px w-[26px] bg-teal opacity-50"></span>About
          </div>
          <h1 class="m-0 font-serif text-[clamp(34px,5vw,52px)] font-medium leading-[1.05] tracking-[-.015em] text-ink">{site.name}</h1>
        </div>
        <div class="min-w-[min(300px,100%)] flex-[1_1_380px]">
          {bio.map((para, i) => (
            <p class={`m-0 mb-[22px] ${i === 0 ? 'text-[19px] leading-[1.62] text-[#3E3933]' : 'text-[17px] leading-[1.66] text-[#46413A]'}`}>{para}</p>
          ))}
          <div class="mt-2 inline-flex items-center gap-2 font-mono text-[12px] text-[#6E675B]">
            <span class="h-2 w-2 rounded-full bg-[#5C8A52] shadow-[0_0_0_3px_rgba(92,138,82,.18)]"></span>{site.availability.label}
          </div>
        </div>
      </div>

      <!-- Experience -->
      <div class="mb-[clamp(48px,7vw,80px)] border-t border-[#DED7C9] pt-[clamp(36px,5vw,56px)]">
        <div class="mb-7 font-mono text-[12px] uppercase tracking-[.14em] text-teal">Experience</div>
        <div class="flex flex-col">
          {experience.map((job) => (
            <div class="flex flex-wrap gap-x-8 gap-y-2 border-b border-[#E4DDCF] py-6">
              <div class="flex-[0_0_150px] pt-[5px] font-mono text-[12.5px] text-[#8C8576]">{job.period}</div>
              <div class="min-w-[min(260px,100%)] flex-[1_1_360px]">
                <div class="mb-[3px] font-serif text-[22px] font-medium text-ink">
                  {job.role} <span class="text-teal">&middot;</span> <span class="text-[18px] text-[#5A5449]">{job.org}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Skills -->
      <div class="">
        <div class="mb-7 font-mono text-[12px] uppercase tracking-[.14em] text-teal">Skills &amp; tools</div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-10 gap-y-7">
          {skills.map((group) => (
            <div>
              <div class="mb-[14px] font-serif text-[18px] text-ink">{group.label}</div>
              <div class="flex flex-wrap gap-[7px]">
                {group.items.map((skill) => (
                  <span class="rounded-full border border-[#E6E1D5] bg-white px-3 py-[6px] text-[13.5px] text-[#46413A] shadow-[0_1px_2px_rgba(28,24,15,.04)]">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
