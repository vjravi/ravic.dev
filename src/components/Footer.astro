---
import { site } from '../data/site';
const socials = [
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'GitHub', href: site.links.github },
  { label: 'Substack', href: site.links.substack },
];
const year = new Date().getFullYear();
---
<footer class="border-t border-[#234740] bg-forest">
  <div class="mx-auto flex max-w-[1180px] flex-wrap items-start justify-between gap-8 px-[clamp(22px,5vw,64px)] py-12">
    <div class="max-w-[340px]">
      <div class="mb-2 font-serif text-[19px] font-semibold text-[#EEF4F1]">
        {site.name}<span class="text-[#6FD6C7]">.</span>
      </div>
      <p class="m-0 text-[14.5px] leading-[1.55] text-[#8FAAA3]">
        Freelance AI engineer &amp; technical architect. Speech recognition, generative AI, and the cloud infrastructure that scales them.
      </p>
    </div>
    <div class="flex flex-col gap-[9px]">
      <a href={`mailto:${site.email}`} class="text-[14px] text-[#B6CDC7] no-underline transition-colors hover:text-[#6FD6C7]">{site.email}</a>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="text-[14px] text-[#B6CDC7] no-underline transition-colors hover:text-[#6FD6C7]">{s.label} &#8599;</a>
      ))}
    </div>
  </div>
  <div class="mx-auto flex max-w-[1180px] flex-wrap justify-between gap-4 px-[clamp(22px,5vw,64px)] pb-9 font-mono text-[11.5px] text-[#6E8C85]">
    <span>&copy; {year} {site.name}</span>
    <span>{site.location}</span>
  </div>
</footer>
